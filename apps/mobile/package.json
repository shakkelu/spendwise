{
  "name": "@spendwise/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "android:build": "expo run:android --variant release --no-bundler"
  },
  "dependencies": {
    "expo": "57.0.31",
    "expo-crypto": "57.0.4",
    "expo-secure-store": "57.0.4",
    "expo-sqlite": "57.0.4",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/react": "19.2.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/test/**/*.test.ts?(x)"
    ],
    "watchman": false
  }
}
