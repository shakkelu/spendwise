{
  "name": "@spendwise/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node --env-file-if-exists=.env dist/src/server.js",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:db": "npm run build && node --env-file=.env.test --test dist/test/*.integration.js"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "express": "5.3.0",
    "mongodb": "7.7.0",
    "nodemailer": "10.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "typescript": "6.0.3"
  }
}
